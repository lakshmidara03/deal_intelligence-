generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  AT_RISK
}

enum DealHealth {
  HEALTHY
  AT_RISK
  NEEDS_REVIEW
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum DriverImpact {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum AccountRole {
  ADMIN
  EMPLOYEE
}

model Employee {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  password  String
  role      AccountRole @default(EMPLOYEE)
  title     String
  createdAt DateTime    @default(now())
  deals     Deal[]
}

model Deal {
  id                 String       @id @default(cuid())
  name               String
  company            String
  owner              String
  employeeId         String?
  value              Int
  stage              DealStage
  closeDate          DateTime
  health             DealHealth   @default(NEEDS_REVIEW)
  healthExplanation  String?
  recommendedAction  String?
  confidence         String       @default("Medium")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  employee           Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  activities         Activity[]
  drivers            DealDriver[]
  insights           DealInsight[]

  @@index([employeeId])
}

model Activity {
  id        String       @id @default(cuid())
  dealId    String
  type      ActivityType
  title     String
  summary   String
  rawText   String
  occurredAt DateTime
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealDriver {
  id          String       @id @default(cuid())
  dealId      String
  label       String
  description String
  impact      DriverImpact
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealInsight {
  id              String   @id @default(cuid())
  dealId          String
  summary         String
  interpretation  String
  generatedAt     DateTime @default(now())
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}
