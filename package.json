{
  "name": "deal-intelligence-poc",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/database"
  ],
  "scripts": {
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run start:dev",
    "db:generate": "npm --prefix packages/database run generate",
