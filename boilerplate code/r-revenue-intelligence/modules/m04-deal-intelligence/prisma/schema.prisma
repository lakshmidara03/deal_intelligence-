// M-04 Deal Intelligence — Prisma schema extension
// These models are defined in the central packages/database/prisma/schema.prisma
// and are referenced here for module-level documentation.

// ─────────────────────────────────────────────────────────────
// MEDDPICC Analysis Storage
// ─────────────────────────────────────────────────────────────

model DealMeddpicc {
  id                String   @id @default(cuid())
  tenantId          String
  dealExternalId    String   // HubSpot / CRM deal ID for direct lookup

  // Overall score (0-100)
  score             Int      @default(0)

  // Category answers — best evidence sentence for each MEDDPICC element
  metrics           String?
  economicBuyer     String?
  decisionCriteria  String?
  decisionProcess   String?
  identifyPain      String?
  champion          String?

  // Derived data
  matchedCategories String[] @default([])
  contactCount      Int      @default(0)
  aiNextStep        String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([dealExternalId])
  @@map("deal_meddpicc")
  @@schema("public")
}
