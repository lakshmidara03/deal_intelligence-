  repName          String?    @map("rep_name")
  createdAt        DateTime   @default(now()) @map("created_at")
  tracker          M02Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  @@index([tenantId, trackerId])
  @@index([tenantId, entityId])
  @@map("m02_tracker_detections")
  @@schema("public")
}

