model LiveCallSession {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  sessionName   String?           @map("session_name")
  salesRepName  String?           @default("Sales Rep") @map("sales_rep_name")
  clientName    String?           @default("Client") @map("client_name")
  contactId     String?           @map("contact_id")
  dealId        String?           @map("deal_id")
  dealCompany   String?           @map("deal_company")
  status        String            @default("active")
  startedAt     DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?         @map("ended_at") @db.Timestamptz(6)
  finalSummary  String?           @map("final_summary") @db.Text
  totalSegments Int               @default(0) @map("total_segments")
  transcript    Json              @default("[]")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  summaries     LiveCallSummary[]

  @@index([tenantId, status])
  @@map("live_call_sessions")
  @@schema("public")
}

model LiveCallSummary {
  id                   String          @id @default(uuid()) @db.Uuid
  sessionId            String          @map("session_id") @db.Uuid
  chunkIndex           Int             @map("chunk_index")
  timeStart            String          @map("time_start")
  timeEnd              String          @map("time_end")
  summaryText          String          @map("summary_text") @db.Text
  keyTopics            String[]        @default([]) @map("key_topics")
  sentiment            String          @default("neutral")
  competitorsMentioned String[]        @default([]) @map("competitors_mentioned")
  rawTranscript        String?         @map("raw_transcript") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  session              LiveCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, chunkIndex])
  @@map("live_call_summaries")
  @@schema("public")
}

model EngageTask {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  taskId          String   @unique @map("task_id")
  title           String   @default("")
  contactId       String?  @map("contact_id")
  contactName     String   @map("contact_name")
  companyName     String   @map("company_name")
  channel         String
  scheduledTime   String?  @map("scheduled_time")
  dueDateTime     String?  @map("due_date_time")
  isOverdue       Boolean  @default(false) @map("is_overdue")
  isAtRisk        Boolean  @default(false) @map("is_at_risk")
  interactionCount Int     @default(0) @map("interaction_count")
  priority        String   @default("NORMAL")
  status          String   @default("PENDING")
  dueDate         String?  @map("due_date")
  dueTime         String?  @map("due_time")
  assigneeId      String?  @map("assignee_id")
  assigneeName    String?  @map("assignee_name")
  assigneeRole    String?  @map("assignee_role")
  aiSignal        String?  @map("ai_signal")
  aiSignalType    String?  @map("ai_signal_type")
  arr             String?
  aiInsight       String?  @map("ai_insight") @db.Text
  notes           String?  @db.Text
  todoType        String?  @map("todo_type")
  entityType      String?  @map("entity_type")
  workflowName    String?  @map("workflow_name")
  workflowStep    String?  @map("workflow_step")
  totalWorkflowSteps Int?  @map("total_workflow_steps")
  snoozedUntil    String?  @map("snoozed_until")
  sequenceName    String?  @map("sequence_name")
  sequenceStep    String?  @map("sequence_step")
  recentActivity  Json?
  recommendedNextSteps String[] @map("recommended_next_steps")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("engage_tasks")
  @@schema("public")
}

