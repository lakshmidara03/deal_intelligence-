model M02Tracker {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  slug      String   @map("slug")
  name      String
  keywords  String[] @default([])
  trend     Int      @default(0)
  aiInsight String?  @map("ai_insight") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
